{
  "name": "myploy",
  "version": "0.1.0",
  "description": "Lightweight, zero-downtime deploy tool for small VPS Docker Compose apps",
  "type": "module",
  "bin": {
    "myploy": "./dist/cli/index.js"
  },
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli/index.ts",
    "start": "node dist/cli/index.js",
    "test": "vitest run"
  },
  "keywords": [
    "deploy",
    "docker",
    "docker-compose",
    "vps",
    "devops",
    "blue-green",
    "zero-downtime",
    "nginx",
    "ssl",
    "certbot"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "ora": "^8.1.0",
    "prompts": "^2.4.2",
    "ssh2": "^1.15.0",
    "tar-fs": "^3.0.6",
    "yaml": "^2.5.1"
  },
  "devDependencies": {
    "@types/node": "^22.5.5",
    "@types/prompts": "^2.4.9",
    "@types/ssh2": "^1.15.1",
    "@types/tar-fs": "^2.0.4",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vitest": "^2.1.1"
  }
}
